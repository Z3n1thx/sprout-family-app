<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon for API 24 and 25, which predate adaptive icons. The two layers
  are the same vectors, stacked flat with no mask and no parallax. Kept because
  minSdk is 24 and shipping a broken icon to a device we chose to support would
  be worse than the twelve lines; mipmap-anydpi-v26 takes over everywhere else.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/sun" />
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
